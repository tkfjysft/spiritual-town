---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

import { getSiteStructure } from '@/data/common/siteStructure';


import townCategoryInfo from '@/data/jp/townCategoryInfo.json';
import metaData from '@/data/meta.json';
import BackToTop from '@/components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  pageTitle?: string;
  category?: { 
    name: string;
    slug: string;
  };
}

const { title, description, pageTitle, category } = Astro.props;

// --- 現在の言語（jp または en）をパスから判定 ---
const rawPath = Astro.url.pathname;
const segments = rawPath.split("/").filter(Boolean);
const lang = segments[0] === 'en' ? 'en' : 'jp';

const siteText = lang === 'en' 
  ? (await import('@/data/en/siteText')).siteText 
  : (await import('@/data/jp/siteText')).siteText;

const siteStructure = getSiteStructure(siteText.langPrefix);


// --- Meta情報の処理 ---
const normalizedPath = rawPath.endsWith('/') && rawPath !== '/' ? rawPath.slice(0, -1) : rawPath;
const normalizedPathWithSlash = normalizedPath + '/';

const matchedPage = metaData.pages[rawPath] || metaData.pages[normalizedPath] || metaData.pages[normalizedPathWithSlash];
const currentTitle = title || matchedPage?.title || metaData.defaultTitle;
const currentDescription = description || matchedPage?.description || metaData.defaultDescription;

// --- パンくずリストの自動判定処理 ---
let pageLabel = "";

if (segments.length > 0) {
  // 多言語のプレフィックス（jp や en）を除外したセグメントで判定を行う
  const pathSegments = (segments[0] === 'jp' || segments[0] === 'en') ? segments.slice(1) : segments;

  if (pathSegments.length > 0) {
    if (rawPath.includes("/oraclecards/draw")) {
      pageLabel = "オラクルカードを引く";
    } else if (pathSegments[0] === "oraclecards" && pathSegments.length === 1) {
      pageLabel = "オラクルカード一覧";
    } else if (pathSegments[0] === "blog" && pathSegments.length > 1) {
      pageLabel = pageTitle || "無題";
    } else {
      const targetId = pathSegments.length > 1 && pathSegments[0] === "category" ? pathSegments[1] : pathSegments[0];
      const matchedCategory = townCategoryInfo.categories.find(item => item.id === targetId);

      if (matchedCategory) {
        pageLabel = matchedCategory.name;
      } else {
        function findLabelFromNavigation(links: any[], path: string): string | null {
          for (const link of links) {
            const cleanLinkUrl = link.url.replace(/\/$/, "");
            const cleanPath = path.replace(/\/$/, "");
            if (cleanLinkUrl === cleanPath || link.url === path) {
              return link.label;
            }
            if (link.children && link.children.length > 0) {
              const found = findLabelFromNavigation(link.children, path);
              if (found) return found;
            }
          }
          return null;
        }
        
        const foundLabel = findLabelFromNavigation(siteStructure.navigation.links, rawPath);
        pageLabel = foundLabel || pathSegments[pathSegments.length - 1];
      }
    }
  }
}

const finalLabel = pageTitle || pageLabel;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{currentTitle}</title>
    <meta name="description" content={currentDescription} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32">
    <link rel="icon" type="image/avif" href="/favicon.avif">
    <link rel="icon" type="image/webp" href="/favicon.webp">

    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>

    <script defer src="https://cloud.umami.is/script.js" data-website-id="43f6bba1-d438-4869-8636-201924c6ab9e"></script>

    <meta name="google-site-verification" content="kOdlstDKziPtP9fDlvEZB6SQe4MHe71SwF2a9A6pYPs" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-78JY0151Q0"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-78JY0151Q0');
    </script>
  </head>
  <body class="bg-slate-50 antialiased pt-16">
    <Header lang={lang} siteText={siteText} />

    <!-- パンくずリスト -->
    {rawPath !== `/${lang}/` && rawPath !== "/" && (
      <nav class="mt-2 md:mt-10 mb-8 text-sm text-gray-500 max-w-6xl mx-auto px-6 md:px-16" aria-label="パンくずリスト">
        <ol class="flex items-center space-x-2 flex-wrap">
          <li>
            <a href={`/${lang}/`} class="hover:text-amber-600 transition-colors">ホーム</a>
          </li>

          {finalLabel && (
            <>
              <li><span class="text-gray-300">/</span></li>
              <li>
                <span class="text-gray-700 font-medium truncate max-w-[200px] inline-block align-bottom">{finalLabel}</span>
              </li>
            </>
          )}
        </ol>
      </nav>
    )}
    <!-- パンくずリストここまで -->

    <main>
      <slot />
    </main>

    <div class="my-24 max-w-6xl mx-auto px-6 md:px-16">
      <a 
        href={siteStructure.navigation.links[4]?.children?.[0]?.url || '#'} target="_blank" rel="noopener noreferrer"
        class="flex items-center justify-center px-8 py-4 my-10 bg-pink-100 text-amber-900 font-bold rounded-full hover:bg-amber-300 transition-all shadow-md hover:shadow-lg"
      >
        {siteStructure.navigation.links[4]?.children?.[0]?.label || 'お問い合わせ'}
      </a>
    </div>

    <Footer lang={lang} siteText={siteText} />
    <BackToTop />
  </body>
</html>