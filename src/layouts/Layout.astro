---
// src/layouts/Layout.astro
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro'; // 共通化推奨
import siteData from '@/data/site.json';

interface Props {
  title?: string;
  description?: string;
}


//meta
//meta
import metaData from '@/data/meta.json';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// 1. 現在のパスを取得し、末尾のスラッシュをいったん統一する（またはそのまま）
const rawPath = Astro.url.pathname;

// 末尾のスラッシュを安全に取り除いたキーでも検索できるようにする
// 例: "/category/fortune/" も "/category/fortune" も両方に対応させる
const normalizedPath = rawPath.endsWith('/') && rawPath !== '/' ? rawPath.slice(0, -1) : rawPath;
const normalizedPathWithSlash = normalizedPath + '/';

// meta.json から、スラッシュあり・なしのどちらかで一致するものを探す
const matchedPage = metaData.pages[rawPath] || metaData.pages[normalizedPath] || metaData.pages[normalizedPathWithSlash];

const currentTitle = title || matchedPage?.title || metaData.defaultTitle;
const currentDescription = description || matchedPage?.description || metaData.defaultDescription;
//meta
//meta

---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{currentTitle}</title>
    <meta name="description" content={currentDescription} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32">
	<link rel="icon" type="image/avif" href="/favicon.avif">
	<link rel="icon" type="image/webp" href="/favicon.webp">

	<link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>


	<script defer src="https://cloud.umami.is/script.js" data-website-id="43f6bba1-d438-4869-8636-201924c6ab9e"></script>

	<!-- サチコ -->
	<meta name="google-site-verification" content="kOdlstDKziPtP9fDlvEZB6SQe4MHe71SwF2a9A6pYPs" />

  </head>
  <body class="bg-slate-50 antialiased pt-16">
    <Header />
    <main>
      <slot /> </main>
    <Footer />
  </body>



</html>