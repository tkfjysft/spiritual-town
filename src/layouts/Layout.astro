---
// src/layouts/Layout.astro
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro'; // 共通化推奨
import siteData from '@/data/site.json';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteData.description } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title ? `${title} | ${siteData.title}` : siteData.title}</title>
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32">
	<link rel="icon" type="image/avif" href="/favicon.avif">
	<link rel="icon" type="image/webp" href="/favicon.webp">

	<link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
	<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>


	<script defer src="https://cloud.umami.is/script.js" data-website-id="43f6bba1-d438-4869-8636-201924c6ab9e"></script>




  </head>
  <body class="bg-slate-50 antialiased pt-16">
    <Header />
    <main>
      <slot /> </main>
    <Footer />
  </body>

  	<script>
  // ページ読み込み時にハッシュ（#mapや#categories）がある場合
  if (window.location.hash) {
    // 1. まずブラウザのデフォルトのジャンプ動作を防ぐため、一時的にスクロールを一番上に固定した状態でレンダリングさせる
    window.scrollTo(0, 0);

    // 2. ページのDOM読み込みが完了した直後に、ターゲット要素へ一瞬で（またはスムーズに）移動させる
    window.addEventListener('DOMContentLoaded', () => {
      const targetElement = document.querySelector(window.location.hash);
      if (targetElement) {
        // 'auto' にすると一瞬の滞在もなくスーッとその場に現れます
        targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }
</script>
</html>