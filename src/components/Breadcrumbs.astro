---
import townCategoryInfo from '@/data/jp/townCategoryInfo.json';

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;

const rawPath = Astro.url.pathname;
const segments = rawPath.split("/").filter(Boolean);

// --- 言語と環境に応じたプレフィックスの決定 ---
const isEn = segments[0] === 'en';
const lang = isEn ? 'en' : 'jp';

// 開発環境かつ日本語の場合は '/jp'、それ以外（英語または本番）のルールに合わせる
// ※ 必要に応じてご自身のルーティング規則に合わせて調整してください
const prefix = isEn ? '/en' : (import.meta.env.DEV ? '/jp' : '');


// パスセグメントから言語部分を除外して純粋な階層だけを取り出す
const pathSegments = (segments[0] === 'en' || segments[0] === 'jp') ? segments.slice(1) : segments;

// --- 【言語別】固定スラッグの名称マッピング ---
const slugLabelMap: Record<string, Record<string, string>> = {
  jp: {
    about: '街について',
    category: 'カテゴリ',
    oraclecards: 'オラクルカード',
    blog: 'ブログ',
    terms: '免責事項',
    'privacy-policy': 'プライバシーポリシー',
    draw: 'オラクルカードを引く',
  },
  en: {
    about: 'About',
    category: 'Category',
    oraclecards: 'Oracle Cards',
    blog: 'Blog',
    terms: 'Disclaimer',
    'privacy-policy': 'Privacy Policy',
    draw: 'Draw Oracle Card',
  }
};

const currentSlugMap = slugLabelMap[lang] || slugLabelMap.jp;

// --- パンくずアイテムの構築 ---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

const items: BreadcrumbItem[] = [];
const isTopPage = pathSegments.length === 0;

if (!isTopPage) {
  // 決定した prefix をベースにリンクを組み立てる
  let currentAccumulatedPath = prefix;

  pathSegments.forEach((segment, index) => {
    currentAccumulatedPath += `/${segment}`;
    let label = '';
    let isLast = index === pathSegments.length - 1;

    if (currentSlugMap[segment]) {
      label = currentSlugMap[segment];
    } else if (pathSegments[0] === 'category' && index === 1) {
      const matchedCategory = townCategoryInfo.categories.find(item => item.id === segment);
      label = matchedCategory ? matchedCategory.name : segment;
    } else {
      label = (isLast && pageTitle) ? pageTitle : segment;
    }

    items.push({
      label: label,
      href: isLast ? undefined : (currentAccumulatedPath + '/')
    });
  });
}

const homeLink = prefix ? `${prefix}/` : '/';
const homeLabel = lang === 'en' ? 'Home' : 'ホーム';
---

{!isTopPage && items.length > 0 && (
  <nav class="mt-2 md:mt-10 mb-8 text-sm text-gray-500 max-w-6xl mx-auto px-6 md:px-16" aria-label="Breadcrumb">
    <ol class="flex items-center space-x-2 flex-wrap">
      <li>
        <a href={homeLink} class="hover:text-amber-600 transition-colors">{homeLabel}</a>
      </li>
      {items.map((item) => (
        <>
          <li><span class="text-gray-300">/</span></li>
          <li>
            {item.href ? (
              <a href={item.href} class="hover:text-amber-600 transition-colors">{item.label}</a>
            ) : (
              <span class="text-gray-700 font-medium truncate max-w-[250px] inline-block align-bottom">{item.label}</span>
            )}
          </li>
        </>
      ))}
    </ol>
  </nav>
)}