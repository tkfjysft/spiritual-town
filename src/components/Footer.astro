---
// Props として各言語の siteText と siteStructure を受け取るようにします
import { getSiteStructure } from '@/data/common/siteStructure';


////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// （※コンポーネントなので getStaticPaths() は書かない）

// ページファイルと【まったく同じ】データ取得
const { lang, prefix, siteText, siteStructure, townCategoryInfo, newsDate, applicationData } = await getPageData(Astro.url);
////////言語切替


// ローカル環境（DEV）で、かつURLに言語プレフィックスがない場合は強制的に '/jp' をセット
if (import.meta.env.DEV && !prefix && !Astro.url.pathname.startsWith('/en')) {
  prefix = '/jp';
}


// ★【重要】URLに prefix（例: /jp）が確実に含まれるようにするヘルパー関数
const applyPrefix = (url: string) => {
  // 外部サイトやハッシュはそのまま
  if (!url || url.startsWith('http') || url.startsWith('//') || url.startsWith('#')) {
    return url;
  }

  // ★すでにURL自体に /en/ や /jp/ が含まれている場合は、そのまま返す（重複防止）
  if (url.startsWith('/en') || url.startsWith('/jp')) {
    return url;
  }

  // それ以外（日本語環境で /about のようになっている場合など）は prefix を結合
  if (prefix && !url.startsWith(prefix)) {
    return `${prefix}${url.startsWith('/') ? '' : '/'}${url}`;
  }
  
  return url;
};

// ナビゲーションリンクのラベル結合 & URLへのプレフィックス適用
const navigationLinks = siteStructure.navigation.links.map((link, index) => ({
  ...link,
  // ★ ここでリンクのURLに prefix を適用
  url: applyPrefix(link.url),
  label: siteText.navigation?.links?.[index]?.label ?? '',
  children: link.children?.map((child, childIndex) => ({
    ...child,
    // ★ 子メニューのURLにも prefix を適用
    url: applyPrefix(child.url),
    label: siteText.navigation?.links?.[index]?.children?.[childIndex]?.label ?? ''
  }))
}));

---

<footer class="bg-[#fdfbf7] border-t border-[#ece8e1] pt-12 mt-16">
    <div class="max-w-6xl mx-auto px-6 md:px-16">

        <!-- 上部コンテンツ：左（サイト紹介）＆ 右（ナビゲーション） -->
        <div class="lg:flex justify-between items-start gap-12 pb-12">
            
            <!-- 左側：サイト紹介 -->
            <div class="lg:w-1/4 mb-8 lg:mb-0">
                <h3 class="font-serif text-[#4a423d] font-bold text-lg mb-3">
                    {siteStructure.titleEn} <br />
                    <span class="text-sm">（{siteText.titleJp || siteText.title}）</span>
                </h3>
                <p class="text-sm text-[#7a726b] leading-relaxed">
                    {siteText.subtitle || "心と体のバランスを整え、明日をもっと前向きに。無料のオラクルカードいやしと占い、信頼できる癒しのスポットを集めた総合ポータルサイトです。"}
                </p>
            </div>

            <!-- 右側：サイトマップ・メニュー（siteStructure.navigation.links を使用） -->
            <div class="lg:w-2/3">
                <h3 class="font-serif text-[#4a423d] font-bold text-sm tracking-wider uppercase mb-6">スピリチュアルタウンの案内</h3>
                
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-x-10 gap-y-8 text-sm">
                    {navigationLinks.map((link: any) => (
                        <div class="space-y-2">
                            {/* 親メニュー */}
                            {link.url ? (
                                <a href={link.url} class="font-bold text-[#4a423d] hover:text-amber-600 transition-colors block whitespace-nowrap"
                                    target={link.target} 
                                    rel={link.rel}
                                >
                                    {link.label || "ホーム"}
                                </a>
                            ) : (
                                <span class="font-bold text-[#4a423d] block whitespace-nowrap">{link.label}</span>
                            )}

                            {/* 子メニュー */}
                            {link.children && link.children.length > 0 && (
                                <ul class="space-y-1.5 text-xs text-[#7a726b]">
                                    {link.children.map((child: any) => (
                                        <li>
                                            <a href={child.url} class="hover:text-[#4a423d] transition-colors block whitespace-nowrap"
                                                target={child.target} 
                                                rel={child.rel}
                                            >
                                                {child.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>

        <div class="flex flex-wrap justify-end gap-6 mt-6 pt-4 border-t-1 border-slate-200">
            <div class="flex items-center gap-8">
                {/* Instagram */}
                <a href="https://www.instagram.com/spi_town?utm_source=qr" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram text-2xl text-stone-500"></i></a>
                {/* LINE */}
                <a href="https://lin.ee/wsdI1Xn" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-line text-2xl text-stone-500"></i></a>
            </div>
        </div>
        
        <div>
            <ul class="flex justify-end gap-8 text-sm text-stone-500 mt-2 border-b-1 border-slate-200 py-6">
                <li><a href={`${prefix}/privacy-policy`}>プライバシーポリシー</a></li>
                <li><a href={`${prefix}/terms`}>免責事項</a></li>
            </ul>
        </div>

    </div>

	
    <div class="text-center text-sm bg-[#7a726b] text-white py-6">
        <p>&copy; {new Date().getFullYear()} {siteStructure.copyrightYear}</p>
    </div>
</footer>