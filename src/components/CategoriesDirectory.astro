---
// 親から渡された individual の category データを受け取る定義
const { category } = Astro.props;
---

{/* 各カテゴリごとの小分類アコーディオン */}
{category.subCategories && category.subCategories.length > 0 && (
    <div class="space-y-3 mt-4 border-t border-slate-100 pt-4">
        {category.subCategories.map((sub) => (
            <details class="group bg-pink-50/30 border border-pink-100/60 rounded-xl p-3 transition-all">
                <summary class="flex items-center justify-between cursor-pointer list-none text-xs md:text-sm font-bold text-slate-700 hover:text-pink-600">
                    <span class="flex items-center space-x-2">
                        <span>{sub.icon}</span>
                        <span>{sub.title}</span>
                    </span>
                    <span class="transform transition-transform duration-200 group-open:rotate-180 text-pink-400">
                        ▼
                    </span>
                </summary>
<div class="mt-3 pt-3 border-t border-pink-100/40 flex flex-wrap gap-1.5">
    {sub.items.map((item) => (
        <span 
            class="inline-block bg-pink-50/60 text-slate-500 text-xs px-2.5 py-1 rounded-full border border-pink-100/60"
        >
            {item}
        </span>
    ))}
</div>
            </details>
        ))}
    </div>
)}

