                        <a 
                            href={`/search?q=${encodeURIComponent(item)}`}
                            class="inline-block bg-white hover:bg-pink-100 text-slate-600 hover:text-pink-600 text-xs px-2.5 py-1 rounded-full border border-pink-100 transition-colors shadow-2xs"
                        >
                            {item}
                        </a>
                    ))} -->