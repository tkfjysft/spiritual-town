---
// src/components/OracleDraw.astro
import { fetchOracleCards } from '../utils/loadOracleCards';
import siteData from '@/data/site.json';

// 全カードデータを取得（ランダム抽選用）
const cards = await fetchOracleCards();
const cardsJson = JSON.stringify(cards);
---

<section class="my-16 px-4 text-center max-w-6xl mx-auto px-6 md:px-16">
  <div class="bg-gradient-to-b from-amber-50/60 to-white p-8 sm:p-10 rounded-3xl border border-amber-200/60 shadow-sm">
    <span class="text-amber-600 font-bold text-sm tracking-wider uppercase">Daily Oracle</span>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mt-2 mb-4">
      今日のオラクルカード <br class="block sm:hidden"><span class="text-sm font-normal text-amber-600">今のあなたに必要なメッセージを引く</span>
    </h1>
	<div class="flex items-center justify-center">
    <p class="text-gray-600 mb-8 leading-relaxed text-left">
      心静かに今のあなたに必要なメッセージを受け取りましょう。無料のオラクルカード占いで、今日の運勢や心を整えるヒントを引いてみてください。<br>カードをクリック（またはボタンを押して）引いてみてください。
    </p>
	</div>

    {/* カードの背表紙を表示するエリア */}
<div class="flex justify-center mb-8">
      <div 
        id="oracle-draw-trigger"
        class="relative w-36 sm:w-44 aspect-[2/3] cursor-pointer group transform transition-all duration-300 hover:-translate-y-2 hover:scale-105"
        title="クリックしてカードを引く"
      >
        {/* 背景と余白（bg-amber-50/30 と p-2）を加え、object-contain で画像全体を収める */}
        <div class="w-full h-full bg-amber-50/30 rounded-2xl py-2 border-0 border-amber-200/80 group-hover:shadow-xl transition-shadow flex items-center justify-center overflow-hidden">
        <img 
            src="/oraclecards/oraclecard_back.webp" 
            alt="オラクルカード背表紙" 
            class="w-full h-full object-contain rounded-xl"
            loading="lazy"
          />
        </div>
        
        {/* ホバー時のオーバーレイ（カード全体を覆うように調整） */}
        <div class="absolute inset-0 bg-black/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
          <span class="bg-white/90 text-gray-900 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
            ✨ カードを引く
          </span>
        </div>
      </div>
    </div>


    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <button 
        id="draw-card-btn"
        class="bg-amber-700 hover:bg-amber-600 text-white font-bold px-8 py-3.5 rounded-full shadow-md transition-all duration-200 transform hover:-translate-y-0.5 cursor-pointer"
      >
        ✨ カードを引く
      </button>

      <a 
        href={siteData.navigation.links[2].children[0].url} 
        class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 font-bold px-8 py-3.5 rounded-full shadow-2xs transition-colors flex items-center justify-center"
      >
        📚 カード一覧を見る
      </a>
    </div>
  </div>
  
</section>

<!-- SEO強化・コンテンツ解説セクション -->
<section class=" max-w-6xl mx-auto px-6 md:px-16">
  <div class="bg-white p-8 sm:p-10 rounded-3xl border border-amber-100 shadow-sm space-y-8">
    
    <!-- 解説1: オラクルカードとは -->
    <div>
      <h3 class="text-xl font-bold text-gray-800 mb-3 flex items-center gap-2">
        <span class="text-amber-600">🔮</span> オラクルカードとは？
      </h3>
      <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
        オラクルカードは、今のあなたに必要なメッセージや、心を整えるためのポジティブなヒントを授けてくれるカードです。タロットカードのような吉凶（良い・悪い）を占うものではなく、いつでも優しく背中を押してくれる言葉や、日常を心地よく過ごすための気づきを与えてくれます。
      </p>
    </div>

    <hr class="border-amber-100">

    <!-- 解説2: 今日のカードを引いたあとの過ごし方 -->
    <div>
      <h3 class="text-xl font-bold text-gray-800 mb-3 flex items-center gap-2">
        <span class="text-amber-600">🌿</span> 今日のカードを引いたあとの過ごし方
      </h3>
      <p class="text-gray-600 leading-relaxed text-sm sm:text-base mb-3">
        引いたカードに書かれているメッセージやイラストから、直感的に感じたことを大切にしてみてください。「なんだか気になるな」「今の自分にしっくりくるな」と感じたそのインスピレーションこそが、今日一日を前向きに過ごすための大切な羅針盤になります。
      </p>
      <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
        当サイトの無料オラクルカード占いは、毎日の運勢チェックや、心をリセットしたいとき、悩みに対して新しい視点を取り入れたいときにいつでも何度でもご利用いただけます。
      </p>
    </div>

  </div>
</section>

<script define:vars={{ cardsJson }}>
  const cards = JSON.parse(cardsJson);

  function drawCard() {
    if (!cards || cards.length === 0) return;

    const randomIndex = Math.floor(Math.random() * cards.length);
    const selectedCard = cards[randomIndex];

    window.location.href = `/oraclecards/${selectedCard.id}`;
  }

  const btn = document.getElementById('draw-card-btn');
  const trigger = document.getElementById('oracle-draw-trigger');

  if (btn) btn.addEventListener('click', drawCard);
  if (trigger) trigger.addEventListener('click', drawCard);
</script>