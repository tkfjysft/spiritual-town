---
import { getPageData } from '@/utils/i18nLoader';

const { lang } = await getPageData(Astro.url);
const currentPath = Astro.url.pathname;

// サーバーサイド（ビルド時やリクエスト時）のコンソールにログが出ます
console.log('--- LanguageSwitcher Debug ---');
console.log('currentPath:', currentPath);
console.log('lang:', lang);
console.log('isDEV:', import.meta.env.DEV);

let otherLangUrl = '';

if (lang === 'en') {
  let cleanPath = currentPath.replace(/^\/en/, '') || '/';
  otherLangUrl = import.meta.env.DEV ? `/jp${cleanPath === '/' ? '' : cleanPath}` : cleanPath;
} else {
  let cleanPath = currentPath;
  if (import.meta.env.DEV) {
    cleanPath = cleanPath.replace(/^\/jp/, '') || '/';
  }
  otherLangUrl = `/en${cleanPath === '/' ? '' : cleanPath}`;
}

console.log('otherLangUrl:', otherLangUrl);
---

<a 
  href={otherLangUrl}
  class="flex items-center gap-1.5 text-sm font-bold px-4 py-2 rounded-full border border-amber-200 text-amber-900 bg-amber-50 hover:bg-amber-100 transition-all shadow-xs"
>
  <i class="fa-solid fa-globe"></i>
  {lang === 'en' ? '日本語' : 'English'}
</a>