---
import { client, type Blog, type Category } from '@/lib/microcms';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  // ① カテゴ and ブログのレスポンス型を明示する
  const categoriesResponse = await client.get<{ contents: Category[] }>({
    endpoint: 'spitown-blog-categories', // microCMSで作ったカテゴリのAPIエンドポイント名
  });

  const blogsResponse = await client.get<{ contents: Blog[] }>({
    endpoint: 'spitown-blog', // 既存のブログAPIエンドポイント名
    queries: { limit: 100 },
  });

  return categoriesResponse.contents.map((category) => {
    const filteredBlogs = blogsResponse.contents.filter(
      (blog) => blog.category && blog.category.id === category.id
    );

    return {
      params: { slug: category.slug || category.id },
      props: { category, blogs: filteredBlogs },
    };
  });
}

const { category, blogs } = Astro.props;
---

<Layout pageTitle={`${category.name}の記事一覧`}>
  <section class="my-16 px-4 text-center max-w-8xl mx-auto px-6 md:px-16">
	<div class="bg-gradient-to-b from-amber-50/60 to-white p-8 sm:p-10 rounded-3xl border border-amber-200/60 shadow-sm">
    <h1 class="text-2xl font-bold mt-10 mb-18 text-slate-800">
      「{category.name}」のカテゴリー記事
    </h1>

    <div class="grid gap-6">
{blogs.length === 0 ? (
      <p>このカテゴリの記事はまだありません。</p>
    ) : (
      <ul class="space-y-6">
        {blogs.map((blog) => (
          <li class="border-b pb-8 border-slate-400 sm:flex text-left sm:justify-between max-w-5xl mx-auto gap-6">
			            <p class="text-gray-500 text-sm mt-1">{new Date(blog.publishedAt).toLocaleDateString()}</p>

            <a href={`/blog/${blog.slug || blog.id}`} class="text-xl font-semibold text-slate-700 hover:underline">
              {blog.title}
            </a>
          </li>
        ))}
      </ul>
    )}
    </div>
	</div>
</section>
</Layout>