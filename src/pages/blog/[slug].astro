---
// src/pages/blog/[slug].astro
import { client, type Blog, type BlogResponse } from '@/lib/microcms';
import Layout from '@/layouts/Layout.astro';

// 1. 静的パス（どのIDのページを作るか）をmicroCMSから全件取得して生成する
export async function getStaticPaths() {
  const response = await client.get<BlogResponse>({
    endpoint: 'spitown-blog', // ご自身のAPIのエンドポイント名に合わせてください
    queries: { limit: 100 }, // 必要に応じて上限数を調整
  });

  return response.contents.map((blog) => ({
    params: { slug: blog.slug || blog.id },
    props: { blog },
  }));
}

// 2. パスに対応するプロパティを受け取る
const { blog } = Astro.props as { blog: Blog };

const safeContent = blog.content
  ? blog.content.replace(/<h1(\s|>)/gi, '<h2$1').replace(/<\/h1>/gi, '</h2>')
  : '';

---

<Layout pageTitle={blog.title} category={blog.category}>
	<div class="max-w-8xl mx-auto px-6 md:px-16">
					<article>
				<!-- 記事ヘッダー -->
				<header class="mb-8">

					
					<!-- ★ カテゴリバッジ（カテゴリが存在する場合のみ表示） -->
{blog.category && (
      <div class="mb-4">
        <a 
          href={`/blog/category/${blog.category.slug}`}
          class="inline-block px-3 py-1 text-xs font-medium bg-amber-50 text-amber-800 rounded-full hover:bg-amber-100 transition-colors"
        >
          {blog.category.name}
        </a>
      </div>
    )}

	
					<time class="text-sm text-stone-500 block mb-3">
						{blog.date ? new Date(blog.date).toLocaleDateString('ja-JP') : new Date(blog.publishedAt).toLocaleDateString('ja-JP')}
					</time>
					<h1 class="font-serif text-3xl md:text-4xl font-bold text-[#4a423d] leading-tight mb-6">
						{blog.title}
					</h1>


					{/* アイキャッチ画像 */}
					{blog.eyecatch && (
						<div class="flex items-center justify-center">
						<div class="aspect-video w-[80vw] md:w-[40vw] overflow-hidden">
							<img 
								src={blog.eyecatch.url} 
								alt="" 
								class="w-full h-full object-cover"
							/>
						</div>
						</div>
					)}
				</header>

{/* 記事本文（microCMSのリッチエディタのHTMLを出力） */}
<div 
					class="blog-content leading-relaxed text-[#4a423d]"
					set:html={safeContent} 
				/>			</article>

			{/* 一覧に戻るボタン */}
			<div class="mt-12 pt-6 border-t border-[#ece8e1]">
				<a href="/blog" class="inline-flex items-center text-sm font-bold text-[#4a423d] hover:text-amber-600 transition-colors">
					← ブログ一覧へ戻る
				</a>
			</div>
		</div>
		</Layout>


		<style>
	.blog-content :global(h2) {
		font-size: 1.5rem; /* 24px相当 */
		font-weight: bold;
		font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
		color: #4a423d;
		margin-top: 2rem;
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid #ece8e1;
	}

	.blog-content :global(h3) {
		font-size: 1.25rem; /* 20px相当 */
		font-weight: bold;
		font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
		color: #4a423d;
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
	}

	.blog-content :global(p) {
		margin-bottom: 1.25rem;
		line-height: 1.8;
	}

	.blog-content :global(ul) {
		list-style-type: disc;
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.blog-content :global(ol) {
		list-style-type: decimal;
		padding-left: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.blog-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.blog-content :global(a) {
		color: #d97706; /* amber-600相当 */
		text-decoration: underline;
	}
</style>