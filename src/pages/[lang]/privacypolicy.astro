---
// src/pages/[lang]/privacypolicy.astro
import Layout from '@/layouts/Layout.astro';





////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// ページファイルにだけ必要な関数
export function getStaticPaths() {
  return getLangStaticPaths();
}

// 全ファイル共通のデータ取得（これをそのまま貼る）
const { lang, prefix, metaData, siteText, siteStructure, townCategoryInfo, newsDate, applicationData, spotsData, aboutData, privacyPolicyData, termsData,  drawData,  oraclecardsData } = await getPageData(Astro.url);


////////言語切替
---

<Layout pageTitle={privacyPolicyData.pageTitle}>
  <div class="max-w-4xl mx-auto px-6 md:px-16 py-16">
    <div class="bg-white p-8 sm:p-12 rounded-3xl border border-amber-200/60 shadow-sm text-[#4a423d] space-y-8">
      
      <h1 class="text-3xl font-serif font-bold text-center mb-10 text-amber-900">
        {privacyPolicyData.heading}
      </h1>

      {privacyPolicyData.sections.map((section) => (
        <section class="space-y-4">
          <h2 class="text-xl font-bold font-serif text-amber-900 border-b border-amber-100 pb-2">
            {section.title}
          </h2>
          <p class="leading-relaxed text-stone-600 text-sm sm:text-base" set:html={section.content} />
        </section>
      ))}

      <div class="pt-8 text-right text-sm text-stone-500">
        {privacyPolicyData.effectiveDate}
      </div>

    </div>
  </div>
</Layout>