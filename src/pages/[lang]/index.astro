---
// 1. スタイルとコンポーネントの読み込み
import '@/styles/global.css';
import Layout from '@/layouts/Layout.astro';
import SpiritualTown from '@/components/SpiritualTown.tsx';
import Header from '@/components/Header.astro';
import CategoriesDirectory from '@/components/CategoriesDirectory.astro';





////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// ページファイルにだけ必要な関数
export function getStaticPaths() {
  return getLangStaticPaths();
}

// 全ファイル共通のデータ取得（これをそのまま貼る）
const { lang, prefix, metaData, siteText, siteStructure, townCategoryInfo, newsDate, applicationData, spotsData, aboutData, privacyPolicyData, termsData,  drawData,  oraclecardsData } = await getPageData(Astro.url);


////////言語切替

---

<Layout>
    <main class="mx-auto py-8">
        
        <!-- ヘッダー・メインビジュアル部分 -->
        <header class="text-center mb-16">
            <h1>
                <img 
                src={`/images/${siteStructure.titleImage}`} 
                alt={siteText.titleJp}
                fetchpriority="high"
                width="542" 
                height="600" 
                class="w-[70vw] md:w-120 mx-auto mb-4"
                loading="eager"
                />
            </h1>
            <p class="text-lg md:text-xl text-slate-500 font-medium tracking-wide">
                {siteText.subtitle}
            </p>
        </header>

        <!-- イントロダクション（説明文）部分 -->
        <section class="bg-white border border-slate-100/80 shadow-md shadow-slate-100 p-8 rounded-3xl text-center leading-relaxed text-slate-600 mb-20 relative mx-[2vw] md:mx-10 lg:mx-auto lg:max-w-3xl">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-teal-50 text-teal-700 text-xs font-bold px-4 py-1 rounded-full uppercase tracking-widest">Welcome</div>
            <p class="text-base md:text-lg text-left">
                <Fragment set:html={siteText.description} />
            </p>
        </section>

        <!-- 掲載案内セクション -->
        <section class="border-y border-slate-400/80 shadow-md shadow-slate-100 p-8 text-center leading-relaxed text-slate-600 mb-20 relative mx-[2vw] md:mx-10 lg:mx-auto lg:max-w-3xl">
            <div class="md:flex md:items-center md:justify-center md:gap-8">
                <div class="mb-8 mx-auto text-white font-bold bg-[#e55a53] shadow-md shadow-slate-100 p-8 rounded-full w-[200px] h-[200px] flex flex-col items-center justify-center">
					<p>
					{applicationData.badge.line1}<br />
					{applicationData.badge.line2}<br />
					{applicationData.badge.line3}<br />
					{applicationData.badge.line4}<br />
					{applicationData.badge.line5}<br />                
					</p>
				   </div>
			<div class="space-y-4">
						<h2 class="text-2xl sm:text-3xl text-[#e55a53] font-bold" set:html={applicationData.heading} />
						<h3 class="text-2xl text-[#ba980c] font-bold" set:html={applicationData.subHeading} />
						<div class="flex items-center justify-center">
							<ol class="text-left space-y-1" style="list-style: decimal;">
								{applicationData.benefits.map((benefit) => (
									<li>{benefit}</li>
								))}
							</ol>
						</div>
			</div>
	    </div>
		<div class="mt-8">
				<a 
					href={`${prefix}/about/#freeReason`}
					class="inline-block mb-4 px-8 py-4 text-amber-900 hover:text-amber-500 transition-all font-medium"
				>
					{applicationData.freeReasonLinkText}
				</a>
				<div>
					<a 
						href={applicationData.button.link} 
						target="_blank" 
						rel="noopener noreferrer"
						class="inline-block px-18 py-4 bg-amber-200 text-amber-900 font-bold rounded-full hover:bg-amber-300 transition-all shadow-md hover:shadow-lg"
					>
						{applicationData.button.text}
					</a>
				</div>
			</div>
        </section>

        <!-- メイン機能（街のマップ）部分 -->
        <section id="map" class="mb-24 scroll-mt-24 max-w-6xl mx-auto px-6 md:px-16">
            <div class="bg-white p-4 rounded-3xl border border-slate-100 shadow-sm">
                <SpiritualTown client:visible prefix={prefix} lang={lang} />
            </div>
        </section>

        <!-- ニュース・おすすめスポット部分 -->
        <section id="featured" class="mb-24 py-16 w-full bg-white">
            <div class="text-center mb-12 max-w-6xl mx-auto px-6 md:px-16">
                <h2 class="text-2xl md:text-3xl font-bold text-amber-900 mb-3">
                    {newsDate.title}
                </h2>
                <p class="text-base text-left text-slate-600 tracking-wide">{newsDate.subtitle}</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-1 gap-8 max-w-6xl mx-auto px-6 md:px-16">
                {newsDate.items.map((spot) => (
                    <div class="bg-white rounded-3xl border border-gray-100 shadow-[0_4px_20px_-5px_rgba(0,0,0,0.1)] flex flex-col group transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
                        <div class="h-3 bg-gradient-to-r from-pink-200 via-sky-200 to-amber-200 rounded-t-3xl"></div>
                        
                        <div class="p-8 flex-1 flex flex-col md:flex-row gap-8">
                            <div class="web-thum md:w-[300px] md:h-[225px] lg:w-[400px] lg:h-[300px] shrink-0">
                                <a href={spot.url} class="block h-full hover:opacity-80 transition-opacity" target="_blank" rel="noopener noreferrer">
                                    <img 
                                        src={spot.image && spot.image.trim() !== "" ? `/images/${spot.image}` : "/images/thum/nothum.avif"} 
                                        alt={spot.name}
                                        loading="lazy"
                                        class="w-full h-full aspect-[4/3] object-cover rounded-2xl shadow-md" 
                                    />
                                </a>
                            </div>

                            <div class="web-detail md:w-2/3 flex flex-col">
                                <!-- 修正箇所：余分な } と ^ を削除してスッキリさせました -->
                                <span class="text-[11px] font-bold text-sky-900 uppercase tracking-widest mb-3 block bg-sky-50 px-2 py-1 rounded-full w-fit">
                                    {spot.date}
                                </span>
                                <h3 class="text-xl font-bold text-amber-900 mb-4">
                                    {spot.name}
                                </h3>
                                <p class="text-slate-600 text-base leading-relaxed mb-8 flex-1">
                                    {spot.description}
                                </p>
                                
                                <div class="flex items-center justify-between pt-6 border-t border-amber-50 gap-2">
                                    <a href={spot.url} class="text-base font-bold bg-amber-200 text-amber-900 px-4 py-2 rounded-full hover:bg-amber-300 transition-all duration-200 shadow-sm whitespace-nowrap" target="_blank" rel="noopener noreferrer">
                                        「{spot.siteName}」のサイトを見る
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- 街の案内所（カテゴリ一覧カード）部分 -->
        <section id="categories" class="mb-24 scroll-mt-24 max-w-6xl mx-auto px-6 md:px-16">
            <div class="text-center mb-12">
                <h2 class="text-2xl md:text-3xl font-bold text-slate-800 mb-3">
                    {townCategoryInfo.title}
                </h2>
                <p class="text-base text-slate-500">{townCategoryInfo.subTitle}</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {townCategoryInfo.categories.map((category) => (
                    <div class="bg-white border border-slate-100 p-6 rounded-2xl shadow-sm hover:shadow-md transition-all duration-200">
                        <div class="text-4xl mb-4">{category.icon}</div>
                        <h3 class="text-xl font-bold text-slate-800 mb-2">
                            {category.name}
                        </h3>
                        <p class="text-slate-600 text-base leading-relaxed mb-4">
                            {category.detailDescription}
                        </p>
<a 

    href={`${prefix}/category/${category.id}`} 
    class="group/btn inline-flex items-center justify-between w-full bg-teal-50 hover:bg-teal-100 text-teal-800 text-base font-bold px-6 py-6 rounded-xl border border-teal-200/60 transition-all shadow-2xs"
>
    <span>{category.linkName}</span>
    <span class="ml-2 transform group-hover/btn:translate-x-1 transition-transform duration-200 text-teal-600">
        →
    </span>
</a>

                        <CategoriesDirectory category={category} />
                    </div>
                ))}
            </div>
        </section>

        <!-- 申込促進セクション -->
        <section class="max-w-6xl mx-auto px-6 md:px-16">
            <div class="py-16 px-6 mt-12 bg-white rounded-3xl border border-stone-200 shadow-sm mx-auto text-center">
                <h2 class="text-2xl md:text-3xl font-bold text-stone-800 mb-4 tracking-tight">
                    {applicationData.title}
                </h2>
                <p class="text-stone-600 mb-10 text-lg">
                    {applicationData.description}
                </p>
                <p class="text-red-400 font-bold mb-10 text-lg">
                    {applicationData.text}
                </p>
                <ul class="flex flex-col md:flex-row justify-center gap-6 mb-12">
                    {applicationData.steps.map((step, index) => (
                        <li class="flex items-center justify-center gap-2">
                            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-amber-100 text-amber-700 font-bold">
                                {index + 1}
                            </span>
                            <span class="text-stone-700 font-medium">{step}</span>
                        </li>
                    ))}
                </ul>

                <a 
                    href={applicationData.button.link} target="_blank" rel="noopener noreferrer"
                    class="inline-block px-8 py-4 bg-amber-200 text-amber-900 font-bold rounded-full hover:bg-amber-300 transition-all shadow-md hover:shadow-lg"
                >
                    {applicationData.button.text}
                </a>
            </div>
        </section>

    </main>
</Layout>