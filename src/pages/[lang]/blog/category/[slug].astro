---
// src/pages/[lang]/blog/category/[slug].astro
import { client, type Blog, type Category } from '@/lib/microcms';
import Layout from '@/layouts/Layout.astro';

// 1. 言語（jp/en）とカテゴリの組み合わせを全件生成
export async function getStaticPaths() {
  const categoriesResponse = await client.get<{ contents: Category[] }>({
    endpoint: 'spitown-blog-categories',
  });

  const blogsResponse = await client.get<{ contents: Blog[] }>({
    endpoint: 'spitown-blog',
    queries: { limit: 100 },
  });

  const languages = ['jp', 'en'];

  // 全言語分 × 全カテゴリ分の組み合わせを作成
  return languages.flatMap((lang) =>
    categoriesResponse.contents.map((category) => {
      const filteredBlogs = blogsResponse.contents.filter(
        (blog) => blog.category && blog.category.id === category.id
      );

      return {
        params: { 
          lang, 
          slug: category.slug || category.id 
        },
        props: { category, blogs: filteredBlogs },
      };
    })
  );
}

// 2. パスに対応するパラメータとプロパティを受け取る
const { lang = 'jp' } = Astro.params;
const { category, blogs } = Astro.props;

// --- コンポーネントのフロントマター ---
// 1. 現在のURLパスから、言語プレフィックスを動的に取得する
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');

// 2. 開発環境か本番か、言語は何かを考慮して正しい prefix を決定する
// 英語なら必ず '/en'、日本語で開発環境なら '/jp'、日本語の本番なら ''
const prefix = isEn 
  ? '/en' 
  : (import.meta.env.DEV ? '/jp' : '');
---

<Layout pageTitle={`${category.name}の記事一覧`}>
  <section class="my-16 px-4 text-center max-w-6xl mx-auto px-6 md:px-16">
    <div class="bg-gradient-to-b from-amber-50/60 to-white p-8 sm:p-10 rounded-3xl border border-amber-200/60 shadow-sm">
      <h1 class="text-2xl font-bold mt-10 mb-18 text-slate-800">
        「{category.name}」のカテゴリー記事
      </h1>

      <div class="grid gap-6">
        {blogs.length === 0 ? (
          <p class="text-slate-500">このカテゴリの記事はまだありません。</p>
        ) : (
          <ul class="space-y-6">
            {blogs.map((blog) => (
              <li class="border-b pb-8 border-slate-200 sm:flex text-left sm:justify-between max-w-5xl mx-auto gap-6 items-center">
                <time class="text-gray-500 text-sm mt-1 whitespace-nowrap">
                  {blog.pubDate ? new Date(blog.pubDate).toLocaleDateString('ja-JP') : new Date(blog.publishedAt).toLocaleDateString('ja-JP')}
                </time>

                {/* 記事詳細へのリンクに言語プレフィックスを付与 */}
                <a href={`${prefix}/blog/${blog.slug || blog.id}`} class="text-xl font-semibold text-slate-700 hover:text-amber-600 transition-colors flex-1">
                  {blog.title}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
</Layout>