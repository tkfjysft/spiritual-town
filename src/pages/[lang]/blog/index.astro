---
// src/pages/[lang]/blog/index.astro
import { client, type BlogResponse } from '@/lib/microcms';
import Layout from '@/layouts/Layout.astro';

// 1. 動的ルート（jp / en）のビルド設定
export function getStaticPaths() {
  return [
    { params: { lang: 'jp' } },
    { params: { lang: 'en' } },
  ];
}

// 現在の言語を取得
const { lang = 'jp' } = Astro.params;

// --- コンポーネントのフロントマター ---
// 1. 現在のURLパスから、言語プレフィックスを動的に取得する
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');

// 2. 開発環境か本番か、言語は何かを考慮して正しい prefix を決定する
// 英語なら必ず '/en'、日本語で開発環境なら '/jp'、日本語の本番なら ''
const prefix = isEn 
  ? '/en' 
  : (import.meta.env.DEV ? '/jp' : '');


// microCMSからブログ記事一覧を取得
const response = await client.get<BlogResponse>({
  endpoint: 'spitown-blog',
  queries: { orders: '-date' }, // 日付の新しい順に並び替え
});

const blogs = response.contents;
---

<Layout>
    <div class="max-w-6xl mx-auto px-6 md:px-16 py-16">
        <h1 class="font-serif text-3xl font-bold mb-8 text-center text-[#4a423d]">ブログ記事一覧</h1>

        {blogs.length === 0 ? (
            <p class="text-center text-stone-500">まだ記事がありません。</p>
        ) : (
            <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
                {blogs.map((blog) => (
                    <article class="bg-white border border-[#ece8e1] rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                        {/* 記事詳細へのリンクに言語プレフィックスを付与 */}
                        <a href={`${prefix}/blog/${blog.slug || blog.id}`} class="block">
                            {/* アイキャッチ画像がある場合 */}
                            {blog.eyecatch && (
                                <div class="aspect-video w-full overflow-hidden bg-stone-100">
                                    <img 
                                        src={blog.eyecatch.url} 
                                        alt="" 
                                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                    />
                                </div>
                            )}
                        </a>
                        <div class="p-6">
                            <time class="text-xs text-stone-500 block mb-2">
                                {blog.pubDate ? new Date(blog.pubDate).toLocaleDateString('ja-JP') : new Date(blog.publishedAt).toLocaleDateString('ja-JP')}
                            </time>

                            {/* カテゴリバッジ（言語プレフィックス付き） */}
                            {blog.category && (
                                <div class="mb-2">
                                    <a 
                                        href={`${prefix}/blog/category/${blog.category.slug}`}
                                        class="inline-block px-2.5 py-0.5 text-xs font-medium bg-amber-50 text-amber-800 rounded-full hover:bg-amber-100 transition-colors"
                                    >
                                        {blog.category.name}
                                    </a>
                                </div>
                            )}

                            <h2 class="font-serif font-bold text-lg text-[#4a423d] hover:text-amber-600 transition-colors line-clamp-2">
                                <a href={`${prefix}/blog/${blog.slug || blog.id}`} class="block">
                                    {blog.title}
                                </a>
                            </h2>
                        </div>
                    </article>
                ))}
            </div>
        )}
    </div>
</Layout>