---
// src/pages/[lang]/blog/[slug].astro
import { client, type Blog, type BlogResponse } from '@/lib/microcms';
import Layout from '@/layouts/Layout.astro';

// 1. 言語（jp/en）とブログ記事の組み合わせを全件生成
export async function getStaticPaths() {
  const response = await client.get<BlogResponse>({
    endpoint: 'spitown-blog',
    queries: { limit: 100 },
  });

  const languages = ['jp', 'en'];

  // 全言語分 × 全記事分の組み合わせを作成
  return languages.flatMap((lang) =>
    response.contents.map((blog) => ({
      params: { 
        lang, 
        slug: blog.slug || blog.id 
      },
      props: { blog },
    }))
  );
}





////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// （※コンポーネントなので getStaticPaths() は書かない）

// ページファイルと【まったく同じ】データ取得
const { lang, prefix, metaData, siteText, siteStructure, townCategoryInfo, newsDate, applicationData, spotsData, aboutData, privacyPolicyData, termsData,  drawData,  oraclecardsData } = await getPageData(Astro.url);


////////言語切替





// 2. パスに対応するパラメータとプロパティを受け取る
const { blog } = Astro.props as { blog: Blog };

const rawContent = lang === 'en' ? blog.content_en : blog.content_jp;
const safeContent = rawContent
  ? rawContent.replace(/<h1(\s|>)/gi, '<h2$1').replace(/<\/h1>/gi, '</h2>')
  : '';

const titleBlog = lang === 'en' ? blog.title_en : blog.title_jp;
const categoryBlog = lang === 'en' ? blog.category_en : blog.category_jp;

---

<Layout pageTitle={titleBlog} category={categoryBlog}>
    <div class="max-w-6xl mx-auto px-6 md:px-16 py-16">
        <article>
            <!-- 記事ヘッダー -->
            <header class="mb-8">
                <!-- カテゴリバッジ（言語プレフィックス付き） -->
                {categoryBlog && (
                    <div class="mb-4">
                        <a 
                            href={`${prefix}/blog/category/${categoryBlog.slug}`}
                            class="inline-block px-3 py-1 text-xs font-medium bg-amber-50 text-amber-800 rounded-full hover:bg-amber-100 transition-colors"
                        >
                            {categoryBlog.name}
                        </a>
                    </div>
                )}

                <time class="text-sm text-stone-500 block mb-3">
                    {blog.pubDate ? new Date(blog.pubDate).toLocaleDateString('ja-JP') : new Date(blog.publishedAt).toLocaleDateString('ja-JP')}
                </time>
                <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#4a423d] leading-tight mb-6">
                    {titleBlog}
                </h1>

                <!-- アイキャッチ画像 -->
                {blog.eyecatch && (
                    <div class="flex items-center justify-center">
                        <div class="aspect-video w-[80vw] md:w-[40vw] overflow-hidden rounded-lg shadow-sm">
                            <img 
                                src={blog.eyecatch.url} 
                                alt="" 
                                class="w-full h-full object-cover"
                            />
                        </div>
                    </div>
                )}
            </header>

            <!-- 記事本文 -->
            <div 
                class="blog-content leading-relaxed text-[#4a423d]"
                set:html={safeContent} 
            />
        </article>

        <!-- 一覧に戻るボタン（言語プレフィックス付き） -->
        <div class="mt-12 pt-6 border-t border-[#ece8e1]">
            <a href={`${prefix}/blog`} class="inline-flex items-center text-sm font-bold text-[#4a423d] hover:text-amber-600 transition-colors">
                ← ブログ一覧へ戻る
            </a>
        </div>
    </div>
</Layout>

<style>
    .blog-content :global(h2) {
        font-size: 1.5rem;
        font-weight: bold;
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
        color: #4a423d;
        margin-top: 2rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #ece8e1;
    }

    .blog-content :global(h3) {
        font-size: 1.25rem;
        font-weight: bold;
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
        color: #4a423d;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }

    .blog-content :global(p) {
        margin-bottom: 1.25rem;
        line-height: 1.8;
    }

    .blog-content :global(ul) {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .blog-content :global(ol) {
        list-style-type: decimal;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .blog-content :global(li) {
        margin-bottom: 0.5rem;
    }

    .blog-content :global(a) {
        color: #d97706;
        text-decoration: underline;
    }
</style>