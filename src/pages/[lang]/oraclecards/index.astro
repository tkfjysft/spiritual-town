---
// src/pages/[lang]/oraclecards/index.astro
import { fetchOracleCards } from '@/utils/loadOracleCards';
import Layout from '@/layouts/Layout.astro';





////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// ページファイルにだけ必要な関数
export function getStaticPaths() {
  return getLangStaticPaths();
}

// 全ファイル共通のデータ取得（これをそのまま貼る）
const { lang, prefix, metaData, siteText, siteStructure, townCategoryInfo, newsDate, applicationData, spotsData, aboutData, privacyPolicyData, termsData,  drawData,  oraclecardsData } = await getPageData(Astro.url);


////////言語切替

// スプレッドシートから全カードを取得
const cards = await fetchOracleCards(lang);

---

<Layout>
  <div class="max-w-6xl mx-auto px-6 md:px-16">

    {/* ページタイトル */}
    <header class="text-center mb-12">
      <h1 class="text-3xl font-bold text-gray-900 mb-3" set:html={oraclecardsData.pageTitle} />
      <p class="text-gray-600" set:html={oraclecardsData.description} />
    </header>

    {/* カード一覧グリッド */}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-5 gap-6">
      {cards.map((card) => (
        <a 
          href={`${prefix}/oraclecards/${card.id}`} 
          class="group bg-white p-4 rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 border border-gray-100 flex flex-col items-center text-center transform hover:-translate-y-1"
        >
          {/* 画像コンテナ */}
          <div class="mb-3 rounded-xl aspect-[2/3] w-full bg-amber-50/30 flex items-center justify-center p-2 overflow-hidden">
            <img 
              src={`/images/oraclecards/${card.image}`} 
              alt={card.title} 
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          <span class="text-xs text-gray-400 mb-1">No. {card.id}</span>
          <h2 class="text-sm font-bold text-gray-800 group-hover:text-amber-600 transition-colors line-clamp-1">
            {card.title}
          </h2>
        </a>
      ))}
    </div>

    <div class="text-center mt-14">
      <a 
         href={prefix || '/'}
        class="inline-block bg-gray-800 hover:bg-gray-900 text-white font-bold px-8 py-3 rounded-full transition-colors shadow-sm"
      >
        {oraclecardsData.buttonText}
      </a>
    </div>

</div>
</Layout>


<!-- {cards.length}枚）をご覧いただけます。 -->