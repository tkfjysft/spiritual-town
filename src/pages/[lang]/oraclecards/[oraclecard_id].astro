---
// src/pages/[lang]/oraclecards/[oraclecard_id].astro
import { fetchOracleCards, type OracleCard } from '@/utils/loadOracleCards';
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  const langs = ['jp', 'en'] as const;
  const paths = [];

  for (const lang of langs) {
    // ★ ループの中（langが定義された後）でデータを取得する
    const cards = await fetchOracleCards(lang);
    
    for (const card of cards) {
      paths.push({
        params: { lang, oraclecard_id: card.id },
        props: { card, lang },
      });
    }
  }
  return paths;
}

interface Props {
  card: OracleCard;
  lang: string;
}

const { card, lang: propLang } = Astro.props;

if (!card) {
  return Astro.redirect('/404');
}





////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// （※コンポーネントなので getStaticPaths() は書かない）

// ページファイルと【まったく同じ】データ取得
const { lang, prefix, metaData, siteText, siteStructure, townCategoryInfo, newsDate, applicationData, spotsData, aboutData, privacyPolicyData, termsData,  drawData,  oraclecardsData } = await getPageData(Astro.url);


////////言語切替




// カテゴリ名の多言語対応マップ
const categoryNameMap: Record<string, { jp: string; en: string }> = {
  fortune: { jp: "占い番地", en: "Fortune District" },
  healing: { jp: "ヒーリング番地", en: "Healing District" },
  shop: { jp: "ショップ番地", en: "Shop District" },
  counseling: { jp: "カウンセリング番地", en: "Counseling District" },
  meditation: { jp: "瞑想番地", en: "Meditation District" },
};

const categorySlug = card.categoryName;
const categoryInfo = categorySlug ? categoryNameMap[categorySlug] : null;

// ★ 現在の言語（isEn）に合わせて .en または .jp を取得する
const categoryDisplayName = categoryInfo 
  ? (lang === 'en' ? categoryInfo.en : categoryInfo.jp) 
  : (categorySlug || "");

const cardDescription = card.message 
  ? (lang === 'en'
      ? `${card.message.slice(0, 100)}... (Message & Meaning of ${card.title})` 
      : `${card.message.slice(0, 100)}...（${card.title}のメッセージと意味）`)
  : (lang === 'en'
      ? `Discover the message and meaning of the oracle card ${card.title}.` 
      : `${card.title}のオラクルカードメッセージと意味をご紹介します。`);

---

<Layout title={`${card.title} ${lang === 'jp' ? "[メッセージ・意味]" : "[Message & Meaning]"} | Spiritual Town ${lang === 'jp' ? "オラクルカード" : "Oraclecard"}`}
description={cardDescription} pageTitle={card.title}
>
  <div class="max-w-6xl mx-auto px-6 md:px-16">
    
    {/* メインのカード詳細コンテナ */}
    <div class="bg-white p-6 sm:p-10 rounded-3xl shadow-sm border border-gray-100">

      {/* カード画像エリア */}
      <div class="flex justify-center mb-10">
        <img 
          src={`/images/oraclecards/${card.image}`} 
          alt={card.title} 
          style="max-width: 280px; width: 100%; height: auto;"
          class="block rounded-xl shadow-lg"
        />
      </div>

      {/* タイトルセクション */}
      <header class="text-center mb-10 border-b border-gray-100 pb-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 tracking-wide">
          {card.title}
        </h1>
		{lang !== 'en' && (
        <p class="text-base sm:text-lg text-gray-600 italic font-serif m-0">
          {card.title_en}
        </p>
		)}

        {/* カテゴリ & 推奨アイテム */}
        <div class="flex justify-center gap-3 mt-6 flex-wrap">
          {categorySlug && (
            <a 
              href={`${prefix}/category/${categorySlug}`} 
              class="bg-gray-100 hover:bg-amber-50 hover:text-amber-700 text-gray-700 px-4 py-1.5 rounded-full text-sm font-medium transition-colors"
            >
              📂 {categoryDisplayName}
            </a>
          )}
          {card.recommendedItem && (
            <span class="bg-indigo-50 text-indigo-700 px-4 py-1.5 rounded-full text-sm font-medium">
              ✨ #{card.recommendedItem}
            </span>
          )}
        </div>
      </header>

      {/* 各メッセージセクション */}
      <section class="max-w-6xl mx-auto mb-8 p-6 sm:p-8 rounded-2xl bg-[#faf8f5] border-l-4 border-amber-400">
        <h2 class="text-lg font-bold text-gray-900 mt-0 mb-3 flex items-center gap-2">
          <span class="text-amber-500">🌸</span> {card.messageTitle || "メッセージ"}
        </h2>
        <p class="leading-relaxed text-gray-700 whitespace-pre-wrap m-0 text-base">
          {card.message}
        </p>
      </section>

      {card.explanation && (
        <section class="max-w-6xl mx-auto mb-8 p-6 sm:p-8 rounded-2xl bg-white border border-gray-100">
          <h2 class="text-lg font-bold text-gray-900 mt-0 mb-3 flex items-center gap-2">
            <span class="text-amber-500">📖</span> {card.explanationTitle || "解説"}
          </h2>
          <p class="leading-relaxed text-gray-700 whitespace-pre-wrap m-0 text-base">
            {card.explanation}
          </p>
        </section>
      )}

      {card.action && (
        <section class="max-w-6xl mx-auto mb-6 p-6 sm:p-8 rounded-2xl bg-[#f0fdf4] border-l-4 border-emerald-400">
          <h2 class="text-lg font-bold text-emerald-900 mt-0 mb-3 flex items-center gap-2">
            <span class="text-emerald-500">🍀</span> {card.actionTitle || "今日のアクション"}
          </h2>
          <p class="leading-relaxed text-[#166534] whitespace-pre-wrap m-0 text-base">
            {card.action}
          </p>
        </section>
      )}

      <div class="text-center mt-10">
        <a 
          href={prefix || '/'}
          class="inline-block bg-gray-800 hover:bg-gray-900 text-white font-bold px-8 py-3 rounded-full transition-colors"
        >
          {oraclecardsData.buttonText}
        </a>
      </div>

    </div>
  </div>
</Layout>