---
// src/pages/[lang]/terms.astro
import Layout from '@/layouts/Layout.astro';






////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// ページファイルにだけ必要な関数
export function getStaticPaths() {
  return getLangStaticPaths();
}

// 全ファイル共通のデータ取得（これをそのまま貼る）
const { lang, prefix, metaData, siteText, siteStructure, townCategoryInfo, newsDate, applicationData, spotsData, aboutData, privacyPolicyData, termsData,  drawData } = await getPageData(Astro.url);


////////言語切替
---

<Layout pageTitle={termsData.pageTitle}>
  <article class="max-w-3xl mx-auto py-16 px-6 text-[#5c544d] leading-relaxed">
    <h1 class="text-3xl font-serif text-[#4a423d] mb-10 text-center">{termsData.heading}</h1>
    
    <div class="bg-white p-8 md:p-12 rounded-2xl border border-[#ece8e1] shadow-sm space-y-8">
      {termsData.sections.map((section) => (
        <section>
          <h2 class="text-xl font-bold text-[#4a423d] mb-4">{section.title}</h2>
          <p>{section.content}</p>
        </section>
      ))}
    </div>
  </article>
</Layout>