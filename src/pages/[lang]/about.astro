---
// src/pages/[lang]/about.astro
import Layout from '@/layouts/Layout.astro';
import aboutData from '@/data/about/about.json';
import { Image } from 'astro:assets';

////////言語切替
import { getLangStaticPaths, getPageData } from '@/utils/i18nLoader';

// ページファイルにだけ必要な関数
export function getStaticPaths() {
  return getLangStaticPaths();
}

// 全ファイル共通のデータ取得（これをそのまま貼る）
const { lang, prefix, siteText, siteStructure, townCategoryInfo, newsDate, applicationData } = await getPageData(Astro.url);
////////言語切替
---

<Layout>
  <article class="mx-auto py-16 text-[#5c544d]">
    
    <section class="text-center mx-[2vw] md:mx-10 lg:mx-auto lg:max-w-3xl mb-16">
      <h1 class="text-4xl font-serif text-[#4a423d] mb-6">{aboutData.hero.title}</h1>
      <p class="text-lg leading-relaxed text-[#7a726b] max-w-2xl mx-auto">
        {aboutData.hero.description}
      </p>
    </section>
    
    <section class="flex items-center justify-center mx-[2vw] md:mx-10 mb-16">
      <div class="rounded-2xl overflow-hidden shadow-md border border-gray-300 bg-white p-2">
        <Image 
          src={`/images/${aboutData.image}`} 
          alt="Spiritual Town" 
          width={1408} 
          height={768}
          class="rounded-xl saturate-[1.4] contrast-[1.05]" 
        />
      </div>
    </section>
  
    <div class="py-30 bg-[#fdfbf7] px-[2vw] md:px-10 lg:mx-auto">
      <div class="max-w-4xl mx-auto">

        <section class="mb-16 bg-white p-10 rounded-2xl border border-gray-300 shadow-sm">
          <h2 class="text-2xl font-serif text-amber-900 mb-6 text-center">
            {aboutData.sections[0].title}
          </h2>
          <p class="leading-loose text-center text-lg text-[#7a726b]">
            {aboutData.sections[0].content}
          </p>
        </section>

        <section id={aboutData.sections[3].id} class="mb-16 scroll-mt-24 bg-white p-10 rounded-2xl border border-gray-300 shadow-sm">
          <h2 class="text-2xl font-serif text-amber-900 mb-6 text-center">
            {aboutData.sections[3].title}
          </h2>
          <p class="leading-loose text-center text-lg text-[#7a726b]">
            {aboutData.sections[3].content}
          </p>
          <h2 class="text-2xl text-amber-900 mt-6 mb-6 text-center">{aboutData.sections[3].subTitle}</h2>
          <ul class="text-center">
            {aboutData.sections[3].list.map((item) => (
                <li class="my-2 font-bold">{item.text}</li>
            ))}
          </ul>
          <p class="text-center">{aboutData.sections[3].content2}</p>
          <p class="mt-6">{aboutData.sections[3].content3}</p>
        </section>

        <section>
          <h2 class="text-2xl font-serif text-[#4a423d] mb-10 text-center">
            {aboutData.sections[1].title}
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            {aboutData.sections[1].features.map((item) => (
              <div class="bg-white p-6 rounded-xl border border-gray-300 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-[#4a423d] mb-3">{item.title}</h3>
                <p class="text-[#7a726b] text-base leading-relaxed">{item.description}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <section class="py-30 px-[2vw] md:px-10 lg:mx-auto">
      <div class="max-w-4xl mx-auto mt-16">
        <h2 class="text-2xl font-serif text-[#4a423d] mb-10 text-center">
          {aboutData.sections[2].title}
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          {aboutData.sections[2].features.map((item) => (
            <div class="bg-white p-6 rounded-xl border border-gray-300 shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-lg font-bold text-center text-[#4a423d] mb-3">{item.title}</h3>
              <div class="text-center pb-4">
                <a href={item.url} target="_blank" rel="noopener noreferrer">
                  <i class={`${item.icon} text-6xl text-stone-500`}></i>
                </a>
              </div>
              <p class="text-[#7a726b] text-base leading-relaxed">{item.description}</p>
              <div class="w-30 flex items-center justify-center mx-auto pt-4">
                <img src={`/images/${item.qr}`} alt={item.url} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </article>
</Layout>